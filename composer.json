{
    "name": "ianm/twofactor",
    "description": "2FA for Flarum",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/imorland/flarum-ext-twofactor/issues",
        "source": "https://github.com/imorland/flarum-ext-twofactor",
        "forum": "https://discuss.flarum.org/d/33339"
    },
    "funding": [
        {
            "url": "https://www.buymeacoffee.com/ianm1"
        }
    ],
    "require": {
        "flarum/core": "^2.1.0-beta.1",
        "spomky-labs/otphp": "^11.2",
        "endroid/qr-code": "^4.8"
    },
    "authors": [
        {
            "name": "IanM",
            "email": "ian@flarum.one",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "IanM\\TwoFactor\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "flarum-extension": {
            "title": "2FA",
            "category": "feature",
            "icon": {
                "name": "fas fa-shield-alt",
                "color": "#fff",
                "backgroundColor": "#0072e3"
            },
            "optional-dependencies": [
                "flectar/flarum-turnstile",
                "fof/oauth",
                "flarum/audit",
                "flarum/oauth-provider",
                "flarum/mcp"
            ]
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": true,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "IanM\\TwoFactor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:unit:filter": "phpunit -c tests/phpunit.unit.xml --filter",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:unit:filter": "Runs unit tests whose name matches: composer test:unit:filter -- ClassName",
        "test:integration": "Runs all integration tests.",
        "test:integration:filter": "Runs integration tests whose name matches: composer test:integration:filter -- ClassName",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "require-dev": {
        "flarum/core": "^2.1.0-beta.1",
        "flarum/testing": "^2.1.0-beta.1",
        "fof/oauth": "^2.0.0",
        "flarum/phpstan": "^2.1.0-beta.1",
        "flarum/gdpr": "^2.1.0-beta.1",
        "flarum/audit": "^2.1.0-beta.1",
        "sycho/flarum-private-facade": "^v0.2.0",
        "flectar/flarum-turnstile": "*",
        "flarum/oauth-provider": "^2.1.0-beta.1",
        "flarum/mcp": "^2.1.0-beta.1"
    }
}
